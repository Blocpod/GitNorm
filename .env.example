# Canonical public address. Set this before real users create passkeys.
APP_ORIGIN=https://gitnorm.example.com
WEBAUTHN_RP_ID=gitnorm.example.com

# Turso / libSQL. Omit both locally to use .gitnorm/gitnorm.db.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Vercel Blob. Vercel creates this when a private Blob store is connected.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token
GITNORM_STORAGE_MODE=blob

# Protects the daily Vercel cleanup job. Generate a long random value.
CRON_SECRET=replace-with-a-long-random-secret
